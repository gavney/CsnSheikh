# Telegram Notifier Settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
BOT_ADMIN_PASSWORD=CasinoBoss2026!Strict#Admin

# Session Provider Direct Override (useful for testing or standalone runs)
PRAGMATIC_JSESSIONID=
PRAGMATIC_SOCKET_SERVER=
PRAGMATIC_CLIENT_ORIGIN=

# Playwright Browser Profile
BROWSER_USER_DATA_DIR=./browser_profile
HEADLESS_BROWSER=true

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# SOCKS5 Proxy for Browser & Casino WebSockets (Telegram Bot connects directly without proxy)
# Вариант 1 (единая строка):
SOCKS5_PROXY=socks5://username:password@127.0.0.1:10808
# Вариант 2 (отдельные переменные):
# SOCKS5_HOST=127.0.0.1
# SOCKS5_PORT=10808
# SOCKS5_USER=username
# SOCKS5_PASSWORD=password
